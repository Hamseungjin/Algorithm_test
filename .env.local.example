# --- Polygonscan / Etherscan V2 ---
# V1 (api.polygonscan.com) is deprecated. The same key works on V2 multichain
# at https://api.etherscan.io/v2/api?chainid=137&...
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# --- Polygon RPC ---
# Optional. If set, used as the first RPC. Falls back to public endpoints
# (polygon-rpc.com, publicnode, llamarpc, 1rpc.io) if it fails.
NEXT_PUBLIC_RPC_URL=https://polygon-rpc.com

# --- Reverse-proxy sub-path ---
# e.g. nginx `location /next/ { proxy_pass http://127.0.0.1:3001; }`
# Leave empty when serving at the domain root.
NEXT_PUBLIC_BASE_PATH=/next

# --- Polymarket CLOB authentication (L2 HMAC) ---
# All four are REQUIRED to call the CLOB API. The address is the wallet that
# owns the API key (the funder/signer who created the key on Polymarket).
# Get them via the clob-client `derive-api-key` flow.
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=
CLOB_ADDRESS=
